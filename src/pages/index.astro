				Browse all articles <span aria-hidden="true">→</span>
			</a>
		</p>
	</section>

	<section class="container home-topics" aria-labelledby="topics-heading">
		<h2 id="topics-heading">Explore topics</h2>
		<div class="chips">
			{categories.map(([cat, count]) => (
				<a class="chip" href={`/categories?topic=${encodeURIComponent(cat)}`}>
