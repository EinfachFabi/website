	<section class="container home-latest" aria-labelledby="latest-heading">
		<h2 id="latest-heading">Latest articles</h2>

		<div class="grid post-grid">
			{latestPosts.map((post) => {
				const formattedDate = post.data.pubDate.toLocaleDateString('en-US', {
					year: 'numeric',
					month: 'long',
					day: 'numeric',
				});
				const rawThumb = post.data.image;
				const thumb = typeof rawThumb === 'string' ? rawThumb : (rawThumb?.src ?? `/images/thumbs/default.svg`);
				return (
					<article class="card card-link">
						<a href={`/${post.id}/`} aria-hidden="true" tabindex="-1">
							<img src={thumb} width="640" height="360" loading="lazy" alt="" />
						</a>
						<div class="card-body">
							<p class="meta">
