---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const allPosts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// 3 Featured posts (either explicitly marked featured: true, or fallback to top 3)
// const explicitlyFeatured = allPosts.filter((p) => p.data.featured);
// const featuredPosts = (explicitlyFeatured.length >= 3 ? explicitlyFeatured : allPosts).slice(0, 3);

// Latest posts
const latestPosts = allPosts.slice(0, 6);

const techCount = allPosts.filter((p) => p.data.category !== 'Travel').length;
const travelCount = allPosts.filter((p) => p.data.category === 'Travel').length;

// Collect categories (topics) with counts for "Explore topics"
const categoryCounts = new Map<string, number>();
for (const post of allPosts) {
	categoryCounts.set(post.data.category, (categoryCounts.get(post.data.category) ?? 0) + 1);
}
const categories = Array.from(categoryCounts.entries());
---

<Layout title="Fabi | Tech Guides & Travel Impressions">
	<section class="home-hero container">
		<p class="eyebrow">Technology &bull; Linux &bull; Travel &amp; Impressions</p>
		<h1>Tech Guides, Linux &amp; Places I’ve Been.</h1>
		<p class="lede">
			Hands-on Linux, homelab, and system tutorials alongside personal travel stories, roadtrips, and vacation impressions.
		</p>

		<div class="topic-cards">
			<a class="topic-card" href="/tech">
				<span class="topic-card-icon" aria-hidden="true">
					<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<polyline points="4 17 10 11 4 5"></polyline>
						<line x1="12" y1="19" x2="20" y2="19"></line>
					</svg>
				</span>
				<span class="topic-card-body">
					<span class="topic-card-title">Tech Guides &amp; Experience</span>
					<span class="topic-card-desc">Linux, Homelab, Server &amp; System Tweaks ({techCount} Posts)</span>
				</span>
				<span class="topic-card-arrow" aria-hidden="true">→</span>
			</a>

			<a class="topic-card" href="/travel">
				<span class="topic-card-icon" aria-hidden="true">
					<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<path d="m8 3 4 8 5-5 5 15H2L8 3z"></path>
					</svg>
				</span>
				<span class="topic-card-body">
					<span class="topic-card-title">Travel &amp; Impressions</span>
					<span class="topic-card-desc">Trips, Roadtrips &amp; Vacation Impressions ({travelCount} Posts)</span>
				</span>
				<span class="topic-card-arrow" aria-hidden="true">→</span>
			</a>
		</div>
	</section>

