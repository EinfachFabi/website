<style>
	.home-hero {
		padding-top: clamp(0.5rem, 1.5vw, 1rem);
	}

	.topic-cards {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.85rem;
		margin-top: 1.5rem;
	}

	.topic-card {
		display: flex;
		align-items: center;
		gap: 1rem;
		padding: 1rem 1.25rem;
		border: 1px solid var(--border);
		border-radius: var(--radius);
		background: var(--surface);
		box-shadow: var(--shadow);
		color: var(--text);
		text-decoration: none;
		transition: transform 0.15s, border-color 0.15s, box-shadow 0.15s;
	}

	.topic-card:hover {
		border-color: var(--accent);
		color: var(--text);
		transform: translateY(-2px);
		box-shadow: 0 14px 32px #0003;
	}

	.topic-card-icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.75rem;
		height: 2.75rem;
		border-radius: var(--radius);
		background: var(--surface-2);
		border: 1px solid var(--border);
		color: var(--accent);
		flex-shrink: 0;
	}

	.topic-card-body {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
		min-width: 0;
		flex: 1;
	}

	.topic-card-title {
		font-weight: 700;
		font-size: 1.12rem;
		line-height: 1.25;
	}

	.topic-card-desc {
		color: var(--muted);
		font-size: 0.9rem;
		line-height: 1.35;
	}

	.topic-card-arrow {
		color: var(--accent);
		font-size: 1.2rem;
		font-weight: 700;
		flex-shrink: 0;
		transition: transform 0.15s;
	}

	.topic-card:hover .topic-card-arrow {
		transform: translateX(3px);
	}

	.home-featured,
	.home-latest,
	.home-topics {
		padding-top: 28px;
	}

	.home-featured h2,
	.home-latest h2,
	.home-topics h2 {
		margin-top: 0;
		margin-bottom: 1rem;
	}

	.home-three-grid {
		grid-template-columns: repeat(3, minmax(0, 1fr));
	}

	.home-latest-cta {
		text-align: right;
		margin-top: 1.25rem;
		margin-bottom: 0;
	}

	@media (width <= 860px) {
		.topic-cards,
		.home-three-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
